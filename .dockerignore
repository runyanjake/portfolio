node_modules
dist
.astro
.git
.gitignore
.vscode
.claude

# Root-level docs only. In .dockerignore, `*` does not match `/`, so this
# covers ./README.md and NOT content/**/*.md -- which is what we want,
# since content/ IS the site.
#
# DO NOT "fix" this to `**/*.md`: that would strip every entry in the
# content tree from the build context. Astro would then build a site with
# nothing in it and still exit 0, so the failure would ship silently.
*.md
