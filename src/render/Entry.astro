---
/**
 * The rendering engine's front door.
 *
 * Hand it a content entry and it decides everything else: the shell, the
 * measure, the header, the rail, the body, and — when the entry is a
 * folder that advertises its contents — the listing of its children.
 * Routes do nothing but find the entry and pass it here; see
 * src/pages/[...slug].astro.
 *
 * Every page on the site is this one component, which is why a section
 * index, a blog post and the home page all carry the same reading
 * column, the same title treatment and the same chrome. They differ in
 * `style:`, and nowhere else.
 */
import { render } from 'astro:content';
import {
  allEntries,
  childrenOf,
  inherited,
  sortEntries,
  urlOf,
  type Entry,
} from '../lib/content';
import Document from './Document.astro';
import Image from './Image.astro';
import Listing from './Listing.astro';
import Mermaid from './markdown/Mermaid.astro';
import Rail from './Rail.astro';
import { hasMermaid } from './markdown';
import { railIsEmpty, resolveRail } from './rail/spec';
import type { Item } from './types';

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
const { title, excerpt, date, author, tags, image, imageAlt, style, width, chrome } = entry.data;

const { Content, headings } = await render(entry);
const entries = await allEntries();

// A listing shows the folder's direct children. `style: page` never
// lists, so a folder can hold entries without advertising them.
let items: Item[] = [];
if (style !== 'page') {
  const children = sortEntries(childrenOf(entries, entry.id), entry.data.sort);
  items = children.map((child) => ({
    // `link:` sends the card off-site; without it, to the child's page.
    url: child.data.link ?? urlOf(child.id),
    external: child.data.link !== undefined,
    title: child.data.title,
    excerpt: child.data.excerpt,
    date: child.data.date,
    image: child.data.image,
    imageAlt: child.data.imageAlt,
  }));
}

// The rail is inherited, so `rail: toc` on content/blog/index.md gives
// every post a contents list without eight files repeating it. A listing
// page gets no rail of its own: progress through a list of links means
// nothing, and the page's substance is the listing, not its prose.
const rail = resolveRail(inherited(entries, entry.id, 'rail'));
const showRail = style === 'page' && !railIsEmpty(rail, headings);

// Diagrams are drawn in the browser, and mermaid is a large library, so
// the renderer is included per page rather than site-wide. Asked of the
// raw body: a page that draws nothing ships no diagram code.
const showMermaid = hasMermaid(entry.body);

const formattedDate = date
  ? date.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      timeZone: 'UTC',
    })
  : null;
---

<Document title={title} description={excerpt} chrome={chrome} width={width}>
  <article
    class="page"
    data-width={width}
    data-style={style}
    data-entry={entry.id}
    data-rail={showRail ? rail.show : undefined}
  >
    <header class="page__header">
      <h1 class="page__title">{title}</h1>
      {(formattedDate || author) && (
        <p class="page__meta">
          {formattedDate && <time datetime={date!.toISOString()}>{formattedDate}</time>}
          {formattedDate && author && <span class="page__meta-sep"> · </span>}
          {author && <span>{author}</span>}
        </p>
      )}
      {tags.length > 0 && (
        <ul class="page__tags">
          {tags.map((tag) => <li>{tag}</li>)}
        </ul>
      )}
      {image && (
        <Image
          src={image}
          alt={imageAlt ?? ''}
          class="page__cover"
          loading="eager"
          widths={[640, 960, 1280]}
        />
      )}
      {entry.data.link && (
        <p class="page__link">
          <a href={entry.data.link} rel="noopener">{new URL(entry.data.link).hostname}</a>
        </p>
      )}
    </header>

    {showRail && <Rail spec={rail} headings={headings} />}

    {showMermaid && <Mermaid />}

    <div class="page__body">
      <Content />
    </div>

    {style !== 'page' && <Listing style={style} items={items} />}
  </article>
</Document>
