---
/**
 * The rendering engine's front door.
 *
 * Hand it a content entry and it renders the whole page. Every decision
 * about what the page contains — the sidebar, the listing, whether it
 * needs the diagram renderer — is made by `buildPage()` in ./page.ts;
 * this component only lays out the resulting `Page`. Routes do nothing
 * but find the entry and pass it here; see src/pages/[...slug].astro.
 *
 * Every page on the site is this one component, which is why a section
 * index, a blog post, a project and the home page all carry the same
 * reading column, the same title treatment and the same chrome. They
 * differ in `style:` and `sidebar:`, and nowhere else.
 */
import type { Entry as ContentEntry } from '../lib/content';
import Document from './Document.astro';
import Image from './Image.astro';
import Lightbox from './Lightbox.astro';
import Listing from './Listing.astro';
import Mermaid from './markdown/Mermaid.astro';
import Sidebar from './Sidebar.astro';
import { buildPage } from './page';

interface Props {
  entry: ContentEntry;
}

const page = await buildPage(Astro.props.entry);
const { Content, title, excerpt, date, author, tags, image, imageAlt, link, style, width, chrome, sidebar } =
  page;

const formattedDate = date
  ? date.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      timeZone: 'UTC',
    })
  : null;
---

<Document title={title} description={excerpt} chrome={chrome} width={width}>
  <article
    class="page"
    data-width={width}
    data-style={style}
    data-entry={page.id}
    data-sidebar={sidebar.kind === 'none' ? undefined : sidebar.kind}
  >
    <header class="page__header">
      <h1 class="page__title">{title}</h1>
      {(formattedDate || author) && (
        <p class="page__meta">
          {formattedDate && <time datetime={date!.toISOString()}>{formattedDate}</time>}
          {formattedDate && author && <span class="page__meta-sep"> · </span>}
          {author && <span>{author}</span>}
        </p>
      )}
      {tags.length > 0 && (
        <ul class="page__tags">
          {tags.map((tag) => <li>{tag}</li>)}
        </ul>
      )}
      {image && (
        <Image
          src={image}
          alt={imageAlt ?? ''}
          class="page__cover"
          loading="eager"
          widths={[640, 960, 1280]}
        />
      )}
      {link && (
        <p class="page__link">
          <a href={link} rel="noopener">{new URL(link).hostname}</a>
        </p>
      )}
    </header>

    {sidebar.kind !== 'none' && <Sidebar sidebar={sidebar} />}

    {page.mermaid && <Mermaid />}

    {page.lightbox && <Lightbox />}

    <div class="page__body">
      <Content />
    </div>

    {page.listing && style !== 'page' && <Listing style={style} items={page.listing} />}
  </article>
</Document>
