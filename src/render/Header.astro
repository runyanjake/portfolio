---
/**
 * Site header. The nav is derived from the content tree — any entry with
 * a `nav:` field in its frontmatter — so adding a section to the nav is
 * adding the field, not editing a list here.
 */
import { site } from '../site.config';
import { siteNav } from '../lib/content';

const links = await siteNav();
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => here === href || (href !== '/' && here.startsWith(`${href}/`));
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="site-header__brand">{site.title}</a>
    <nav class="site-header__nav" aria-label="Primary">
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
