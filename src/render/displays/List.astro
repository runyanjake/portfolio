---
/**
 * Dated entries, newest first — the shape a blog or a project log wants.
 * Title, date, excerpt, one per row.
 */
import type { Item } from '../types';

interface Props {
  items: Item[];
}

const { items } = Astro.props;
const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<ul class="display-list">
  {items.map((item) => (
    <li class="display-list__item">
      <a
        href={item.url}
        class="display-list__link"
        rel={item.external ? 'noopener' : undefined}
      >
        <h2 class="display-list__title">{item.title}</h2>
        {item.date && (
          <time class="display-list__date" datetime={item.date.toISOString()}>
            {formatDate(item.date)}
          </time>
        )}
        {item.excerpt && <p class="display-list__excerpt">{item.excerpt}</p>}
      </a>
    </li>
  ))}
</ul>
