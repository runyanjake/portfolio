---
/**
 * The document shell: <html>, <head>, the site chrome, and the main
 * landmark. Everything the site renders — content entries and the 404
 * alike — comes out through here.
 *
 * It knows nothing about content. It takes a title, a description and
 * the two presentation switches, and that is the whole contract.
 */
import { ClientRouter } from 'astro:transitions';
import { site } from '../site.config';
import Header from './Header.astro';
import Footer from './Footer.astro';

export type Chrome = 'default' | 'minimal' | 'bare';
export type Width = 'article' | 'wide' | 'full' | 'canvas';

interface Props {
  title?: string;
  description?: string;
  chrome?: Chrome;
  width?: Width;
}

const { title, description, chrome = 'default', width = 'article' } = Astro.props;

// `chrome` opts a page out of the site shell. The skip link and the
// #main-content landmark are emitted at every level — a page may be
// bare, but never unnavigable.
const showHeader = chrome !== 'bare';
const showFooter = chrome === 'default';
const pageTitle = title && title !== site.title ? `${title} — ${site.title}` : site.title;
const metaDescription = description ?? site.description;

// Themes -------------------------------------------------------------
// A theme is a directory under src/themes/<name>/ with an index.css
// entry point. Selection lives in site.config.ts; an array layers them,
// later entries cascading over earlier ones.
const themeUrls = import.meta.glob<string>('../themes/*/index.css', {
  query: '?url',
  import: 'default',
  eager: true,
});
const activeThemes = Array.isArray(site.theme) ? site.theme : [site.theme];
const themeHrefs = activeThemes.map((name) => {
  const url = themeUrls[`../themes/${name}/index.css`];
  if (!url) throw new Error(`Theme "${name}" not found in src/themes/`);
  return url;
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    {themeHrefs.map((href) => <link rel="stylesheet" href={href} />)}
    <title>{pageTitle}</title>
    {metaDescription && <meta name="description" content={metaDescription} />}

    {/*
      The color scheme, resolved at the highest point there is: an
      attribute on <html>, set before first paint. Everything downstream
      is a custom property that changes with it, so no component knows
      which scheme it is in and none can be left behind by a switch.

      `is:inline` is required. A bundled script is deferred, which would
      paint the default scheme first and then correct it — the flash this
      exists to avoid. It has to be small and dependency-free for the
      same reason, so it lives here as source rather than as an import.

      Three listeners keep it honest after load:
        - astro:after-swap, because ClientRouter replaces <html>'s
          attributes with the incoming document's, which has no
          data-theme. Without this, one navigation reverts the scheme.
        - a click delegated from document, so the toggle button keeps
          working across navigations without rebinding.
        - the media query, so a visitor who has never chosen follows
          their OS live, and one who has chosen is left alone.
    */}
    <script is:inline>
      (() => {
        const KEY = 'theme';
        const root = document.documentElement;
        const system = window.matchMedia('(prefers-color-scheme: light)');

        const stored = () => {
          try {
            const v = localStorage.getItem(KEY);
            return v === 'light' || v === 'dark' ? v : null;
          } catch {
            // Private mode and blocked site data both throw here.
            return null;
          }
        };

        const apply = () => {
          root.dataset.theme = stored() ?? (system.matches ? 'light' : 'dark');
        };

        apply();
        document.addEventListener('astro:after-swap', apply);
        system.addEventListener('change', () => {
          if (!stored()) apply();
        });

        document.addEventListener('click', (event) => {
          if (!event.target.closest('[data-theme-toggle]')) return;
          const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try {
            localStorage.setItem(KEY, next);
          } catch {
            // Unstorable choice still applies for this page view.
          }
        });
      })();
    </script>

    <ClientRouter />
  </head>
  <body>
    <a href="#main-content" class="skip-to-content">Skip to content</a>
    {showHeader && <Header />}
    <main id="main-content" class="site-main" data-width={width}>
      <slot />
    </main>
    {showFooter && <Footer />}
  </body>
</html>
