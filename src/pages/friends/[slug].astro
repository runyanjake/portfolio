---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { blocks } from '../../components/mdx';

export const getStaticPaths = (async () => {
  const friends = await getCollection('friends', ({ data }) => !data.draft);
  return friends.map((friend) => ({
    params: { slug: friend.id },
    props: { friend },
  }));
}) satisfies GetStaticPaths;

const { friend } = Astro.props;
const { Content, headings } = await render(friend);
---

<PageLayout
  title={friend.data.title}
  excerpt={friend.data.excerpt}
  headings={headings}
  width={friend.data.width}
  chrome={friend.data.chrome}
  entry={`friends/${friend.id}`}
>
  <Content components={blocks} />
</PageLayout>
