---
import { getCollection } from 'astro:content';
import IndexLayout from '../../layouts/IndexLayout.astro';
import type { IndexItem } from '../../lib/types';

const entries = await getCollection('about', ({ data }) => !data.draft);
entries.sort((a, b) => {
  const oa = a.data.order ?? Number.POSITIVE_INFINITY;
  const ob = b.data.order ?? Number.POSITIVE_INFINITY;
  if (oa !== ob) return oa - ob;
  return a.data.title.localeCompare(b.data.title);
});

const items: IndexItem[] = entries.map((e) => ({
  url: `/about/${e.id}`,
  title: e.data.title,
  excerpt: e.data.excerpt,
  cover: e.data.cover,
  coverAlt: e.data.coverAlt,
}));
---

<IndexLayout title="About" items={items} display="cards">
  <p>Learn more about me and the passion projects I work on.</p>
</IndexLayout>
