---
import { getCollection } from 'astro:content';
import IndexLayout from '../../layouts/IndexLayout.astro';
import type { IndexItem } from '../../lib/types';

const projects = await getCollection('projects', ({ data }) => !data.draft);
projects.sort((a, b) => {
  const da = a.data.date?.getTime() ?? 0;
  const db = b.data.date?.getTime() ?? 0;
  return db - da;
});

const items: IndexItem[] = projects.map((p) => ({
  url: `/projects/${p.id}`,
  title: p.data.title,
  excerpt: p.data.excerpt,
  date: p.data.date,
  cover: p.data.cover,
  coverAlt: p.data.coverAlt,
}));
---

<IndexLayout title="Projects" items={items} display="list">
  <p>Some of my projects — check out what I'm working on!</p>
</IndexLayout>
