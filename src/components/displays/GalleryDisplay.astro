---
import SmartImage from '../SmartImage.astro';
import type { IndexItem } from '../../lib/types';

interface Props {
  items: IndexItem[];
}

const { items } = Astro.props;
const photos = items.filter((i) => i.image ?? i.cover);
---

<ul class="display-gallery">
  {photos.map((item) => {
    const img = (item.image ?? item.cover)!;
    return (
      <li class="display-gallery__item">
        <a href={item.url} class="display-gallery__link">
          <figure class="display-gallery__figure">
            <SmartImage
              src={img}
              alt={item.excerpt ?? item.title}
              widths={[320, 480, 640, 960]}
              sizes="(min-width: 1080px) 320px, (min-width: 720px) 33vw, 50vw"
              class="display-gallery__image"
            />
            <figcaption class="display-gallery__caption">{item.title}</figcaption>
          </figure>
        </a>
      </li>
    );
  })}
</ul>
