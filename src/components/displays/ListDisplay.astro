---
import type { IndexItem } from '../../lib/types';

interface Props {
  items: IndexItem[];
}

const { items } = Astro.props;
---

<ul class="display-list">
  {items.map((item) => (
    <li class="display-list__item">
      <a href={item.url} class="display-list__link">
        <h2 class="display-list__title">{item.title}</h2>
        {item.date && (
          <time class="display-list__date" datetime={item.date.toISOString()}>
            {item.date.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
              timeZone: 'UTC',
            })}
          </time>
        )}
        {item.excerpt && <p class="display-list__excerpt">{item.excerpt}</p>}
      </a>
    </li>
  ))}
</ul>
