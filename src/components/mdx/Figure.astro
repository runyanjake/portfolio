---
import SmartImage from '../SmartImage.astro';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  caption?: string;
  bleed?: 'none' | 'wide' | 'full';
}

const { src, alt, caption, bleed = 'none' } = Astro.props;
---

<figure class="figure" data-bleed={bleed}>
  <SmartImage src={src} alt={alt} widths={[480, 720, 1080, 1440]} />
  {caption && <figcaption class="figure__caption">{caption}</figcaption>}
</figure>
