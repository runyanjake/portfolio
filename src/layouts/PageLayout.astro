---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import type { Chrome, Width } from './BaseLayout.astro';
import SmartImage from '../components/SmartImage.astro';

interface Props {
  title: string;
  excerpt?: string;
  date?: Date;
  author?: string;
  tags?: string[];
  cover?: ImageMetadata;
  coverAlt?: string;
  headings?: MarkdownHeading[];
  width?: Width;
  chrome?: Chrome;
  /** `<collection>/<id>`, exposed as [data-entry] so a theme or a page
   *  stylesheet can target exactly one entry. Part of the theme contract. */
  entry?: string;
}

const {
  title,
  excerpt,
  date,
  author,
  tags = [],
  cover,
  coverAlt,
  headings = [],
  width = 'article',
  chrome = 'default',
  entry,
} = Astro.props;

const formattedDate = date
  ? date.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      timeZone: 'UTC',
    })
  : null;
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const showToc = tocHeadings.length >= 3;
---

<BaseLayout title={title} description={excerpt} chrome={chrome} width={width}>
  <article class="page" data-width={width} data-entry={entry}>
    <div class="page__content">
      <header class="page__header">
        <h1 class="page__title">{title}</h1>
        {(formattedDate || author) && (
          <p class="page__meta">
            {formattedDate && <time datetime={date!.toISOString()}>{formattedDate}</time>}
            {formattedDate && author && <span class="page__meta-sep"> · </span>}
            {author && <span>{author}</span>}
          </p>
        )}
        {tags.length > 0 && (
          <ul class="page__tags">
            {tags.map((t) => <li>{t}</li>)}
          </ul>
        )}
        {cover && (
          <SmartImage
            src={cover}
            alt={coverAlt ?? ''}
            class="page__cover"
            loading="eager"
            widths={[640, 960, 1280]}
          />
        )}
      </header>

      {showToc && (
        <nav class="page__toc" aria-label="Table of contents">
          <p class="page__toc-title">On this page</p>
          <ul>
            {tocHeadings.map((h) => (
              <li class={`page__toc-item page__toc-item--depth-${h.depth}`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      <div class="page__body">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>
