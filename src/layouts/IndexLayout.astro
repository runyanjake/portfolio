---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { entryFolder } from '../lib/routing';

export type IndexItem = {
  url: string;
  data: CollectionEntry<'pages'>['data'];
};

interface Props {
  entry: CollectionEntry<'pages'>;
  url: string;
  items: IndexItem[];
}

const { entry, items, url } = Astro.props;
const displayName = (entry.data.display ?? 'list').toLowerCase();

// Registry: any Astro component at src/components/displays/<Name>Display.astro
// is registered as display "<name>" (lowercased stem, minus the "Display"
// suffix). Drop a new file in that folder and reference it in frontmatter
// via `display: <name>` — no other code changes required.
const modules = import.meta.glob<{ default: any }>(
  '../components/displays/*.astro',
  { eager: true },
);
const registry: Record<string, any> = {};
for (const [path, mod] of Object.entries(modules)) {
  const stem = path.split('/').pop()!.replace(/\.astro$/, '');
  const name = stem.replace(/Display$/, '').toLowerCase();
  registry[name] = mod.default;
}
const DisplayComponent = registry[displayName] ?? registry['list'];
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.excerpt}
  scripts={entry.data.scripts}
  styles={entry.data.styles}
  shell={entry.data.shell}
  entryFolder={entryFolder(entry)}
>
  <section class="index">
    <header class="index__header">
      <h1 class="index__title">{entry.data.title}</h1>
    </header>

    {Astro.slots.has('default') && (
      <div class="index__intro">
        <slot />
      </div>
    )}

    {items.length === 0 ? (
      <p class="index__empty">No entries here yet.</p>
    ) : (
      <DisplayComponent items={items} currentUrl={url} />
    )}
  </section>
</BaseLayout>
