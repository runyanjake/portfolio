---
import type { IndexItem } from '../lib/types';
import BaseLayout from './BaseLayout.astro';
import CardsDisplay from '../components/displays/CardsDisplay.astro';
import GalleryDisplay from '../components/displays/GalleryDisplay.astro';
import GridDisplay from '../components/displays/GridDisplay.astro';
import ListDisplay from '../components/displays/ListDisplay.astro';

export type Display = 'list' | 'cards' | 'grid' | 'gallery';

interface Props {
  title: string;
  excerpt?: string;
  items: IndexItem[];
  display?: Display;
}

const { title, excerpt, items, display = 'list' } = Astro.props;

const displays = {
  list: ListDisplay,
  cards: CardsDisplay,
  grid: GridDisplay,
  gallery: GalleryDisplay,
} as const;
const DisplayComponent = displays[display];
---

<BaseLayout title={title} description={excerpt}>
  <section class="index">
    <header class="index__header">
      <h1 class="index__title">{title}</h1>
    </header>

    {Astro.slots.has('default') && (
      <div class="index__intro">
        <slot />
      </div>
    )}

    {items.length === 0 ? (
      <p class="index__empty">No entries here yet.</p>
    ) : (
      <DisplayComponent items={items} />
    )}
  </section>
</BaseLayout>
